# ── Log gate ─────────────────────────────────────────────
# Password required to open the /log page and write measurements.
# Verified SERVER-SIDE only (see app/api/log/verify + app/api/submit),
# so it never ships in the client bundle.
#
# Set this in Vercel → Project → Settings → Environment Variables,
# and locally in .env.local. If unset, logging is disabled (fail closed).
#
# NOTE: pick a NEW value — the previous password lived in the source and
# is still visible in git history, so treat it as compromised.
LOG_PASSWORD=change-me
