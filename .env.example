# ── Log gate ─────────────────────────────────────────────
# Password required to open the /log page and write measurements.
# Verified SERVER-SIDE only (see app/api/log/verify + app/api/submit),
# so it never ships in the client bundle.
#
# Set this in Vercel → Project → Settings → Environment Variables,
# and locally in .env.local. If unset, logging is disabled (fail closed).
#
# NOTE: pick a NEW value — the previous password lived in the source and
# is still visible in git history, so treat it as compromised.
LOG_PASSWORD=change-me

# ── Database (Neon Postgres) ─────────────────────────────
# Measurements live in Postgres (replaces Google Sheets). Add the Neon
# integration in Vercel → Storage; it injects these automatically in prod.
# For local dev, copy the pooled connection string from the Neon dashboard.
# The app reads the first of: DATABASE_URL, POSTGRES_URL, POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Social + activities (Upstash Redis) ──────────────────
# Already used for reactions/comments/bookings. Unset → those features fall
# back to localStorage-only. Reads either KV_* or UPSTASH_REDIS_* pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
